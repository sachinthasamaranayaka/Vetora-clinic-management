<?xml version='1.0' encoding='UTF-8'?>
<jasperReport name="Vetora_PaymentSummary" language="java" pageWidth="595" pageHeight="842" orientation="Portrait" whenNoDataType="AllSectionsNoDetail" columnWidth="545" leftMargin="25" rightMargin="25" topMargin="26" bottomMargin="26" uuid="727616ac-2d77-4af7-a4d5-22efbeaccd19">
  <property name="com.jaspersoft.studio.data.defaultdataadapter" value="VetoraDB"/>
  <parameter name="FROM_DATE" class="java.sql.Date">
    <defaultValueExpression><![CDATA[java.sql.Date.valueOf("2026-10-01")]]></defaultValueExpression>
  </parameter>
  <parameter name="TO_DATE" class="java.sql.Date">
    <defaultValueExpression><![CDATA[java.sql.Date.valueOf("2026-10-31")]]></defaultValueExpression>
  </parameter>
  <query language="SQL"><![CDATA[SELECT pay.payment_id, pay.paid_at, inv.invoice_id, inv.owner_name,
 pay.payment_method, pay.amount
FROM payments pay
INNER JOIN invoices inv ON inv.invoice_id = pay.invoice_id
WHERE pay.paid_at >= $P{FROM_DATE}
 AND pay.paid_at < DATE_ADD($P{TO_DATE}, INTERVAL 1 DAY)
ORDER BY pay.paid_at, pay.payment_id]]></query>
  <field name="payment_id" class="java.lang.Long"/>
  <field name="paid_at" class="java.sql.Timestamp"/>
  <field name="invoice_id" class="java.lang.Long"/>
  <field name="owner_name" class="java.lang.String"/>
  <field name="payment_method" class="java.lang.String"/>
  <field name="amount" class="java.math.BigDecimal"/>
  <variable name="TotalPayments" calculation="Sum" resetType="Report" class="java.math.BigDecimal">
    <expression><![CDATA[$F{amount}]]></expression>
    <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
  </variable>
  <title height="105">
    <element kind="staticText" uuid="a4dcc382-361d-4f65-b7cd-05f9f525797a" x="0" y="0" width="545" height="45" fontName="SansSerif" fontSize="18.0" forecolor="#FFFFFF" mode="Opaque" backcolor="#172B36" bold="true" vTextAlign="Middle">
      <text><![CDATA[VETORA  |  VETERINARY CLINIC]]></text>
