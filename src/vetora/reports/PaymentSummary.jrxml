      <expression><![CDATA["Period: " + new java.text.SimpleDateFormat("dd MMM yyyy").format($P{FROM_DATE}) + " to " + new java.text.SimpleDateFormat("dd MMM yyyy").format($P{TO_DATE})]]></expression>
      <box leftPadding="6" rightPadding="5" topPadding="5" bottomPadding="4"/>
    </element>
  </title>
